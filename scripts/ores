#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd -P)"
compiler="${ORESLANG_SOURCE_DIR:-$root/../oreslang-source.java}"
fail() { printf 'Oreslang launcher preflight failed: %s\n' "$*" >&2; exit 69; }
# Explicit runtime choice must never silently fall back to a different JDK.
if [[ -n "${ORES_JAVA:-}" ]]; then
  java_bin="$ORES_JAVA"
else
  java_bin=/opt/homebrew/opt/openjdk@25/bin/java
  if [[ ! -x "$java_bin" ]]; then java_bin=java; fi
fi
command -v "$java_bin" >/dev/null 2>&1 || fail 'Java executable not found'
version="$("$java_bin" -version 2>&1 | head -n 1)" || fail 'cannot inspect Java version'
[[ "$version" =~ \"25([.\"]|$) ]] || fail "JDK 25 required, observed: $version"
[[ -d "$compiler" ]] || fail 'authorized compiler checkout missing'
[[ -f "$root/SOURCE_REF" ]] || fail 'SOURCE_REF missing'
expected="$(tr -d '\r\n' < "$root/SOURCE_REF")"
[[ "$expected" =~ ^[0-9a-f]{40}$ ]] || fail 'invalid compiler SOURCE_REF'
actual="$(git -C "$compiler" rev-parse HEAD 2>/dev/null)" || fail 'compiler HEAD unavailable'
[[ "$actual" == "$expected" ]] || fail 'Compiler revision mismatch'
[[ -z "$(git -C "$compiler" status --porcelain --untracked-files=no)" ]] || fail 'Compiler has tracked modifications'
[[ -z "$(git -C "$compiler" ls-files --others -- src pom.xml .mvn)" ]] || fail 'Compiler has untracked or ignored build inputs'
cpfile="$compiler/target/classpath.txt"
# Never substitute an alternate or stale classpath for the Maven output.
[[ -s "$cpfile" && ! -L "$cpfile" ]] || fail 'Generated runtime classpath missing, empty, or a symlink'
launcher_class="$compiler/target/classes/dev/oreslang/launcher/OresMain.class"
[[ -f "$launcher_class" && ! -L "$launcher_class" ]] || fail 'Compiled OresMain.class missing or a symlink'
exec "$java_bin" --enable-native-access=ALL-UNNAMED -Dpolyglot.engine.WarnInterpreterOnly=false -cp "$compiler/target/classes:$(cat "$cpfile")" dev.oreslang.launcher.OresMain "$@"
