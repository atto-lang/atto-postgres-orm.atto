import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, expect_false, expect_equal_int, expect_equal_string, expect_near_float, run_suite, require_success, fail from "ores.std/testing";
import module pg from "../src/pg";
fnc quoted_identifier_escapes_quotes(): TestOutcome {
  return expect_equal_string(pg.ident("a\"b"), "\"a\"\"b\"",
    "identifier quotes must be doubled to prevent SQL syntax injection");
}
fnc unsupported_type_is_rejected(): TestOutcome {
  return expect_true(pg.column("status", "varchar", false).is_err(),
    "SQL type spellings must be allowlisted");
}
fnc query_values_remain_separate_from_sql(): TestOutcome {
  val query = pg.find_in_workspace("orders", "tenant-1", "row-2");
  return expect_true(query.sql.contains_literal("$1::uuid") &&
    query.sql.contains_literal("$2::uuid") && !query.sql.contains_literal("tenant-1") &&
    query.params.size == 2 && query.params.get(0) == "tenant-1" &&
    query.params.get(1) == "row-2",
    "workspace and ID must remain separately bound SQL parameters");
}
pub routine main(): void {
  val TestSuite suite = new TestSuite("postgres-orm", arr[
    new TestCase("quoted_identifier_escapes_quotes", quoted_identifier_escapes_quotes, false, ""),
    new TestCase("unsupported_type_is_rejected", unsupported_type_is_rejected, false, ""),
    new TestCase("query_values_remain_separate_from_sql", query_values_remain_separate_from_sql, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
