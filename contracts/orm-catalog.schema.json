{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ores:orm:catalog:v1",
  "title": "Ores ORM portable catalog v1",
  "description": "Independently authored peer JSON Schema authority. Stable IDs require reviewed mapping for database introspection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tables"
  ],
  "properties": {
    "schema_version": {
      "const": "ores.orm.catalog/v1"
    },
    "tables": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/Table"
      }
    }
  },
  "$defs": {
    "ColumnKind": {
      "type": "string",
      "enum": [
        "uuid",
        "string",
        "int32",
        "int64",
        "boolean",
        "json",
        "timestamp",
        "bytes"
      ]
    },
    "Column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_id",
        "name",
        "kind",
        "nullable"
      ],
      "properties": {
        "stable_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "kind": {
          "$ref": "#/$defs/ColumnKind"
        },
        "nullable": {
          "type": "boolean"
        }
      }
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_id",
        "name",
        "columns"
      ],
      "properties": {
        "stable_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/Column"
          }
        }
      }
    }
  }
}
