{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/oreslang-orm/document-row.v1.schema.json",
  "$defs": {
    "DocumentRow": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workspace_id",
        "id",
        "title",
        "note"
      ],
      "additionalProperties": false
    }
  }
}
